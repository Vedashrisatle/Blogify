button,.btn,.search-btn,.clear-btn{border:0;border-radius:11px!important;font-weight:700!important;transition:transform .2s ease,box-shadow .2s ease,background .2s ease}.btn-primary,.search-btn,button[type=submit],.btn-login,.hero .btn{background:linear-gradient(135deg,var(--brand),var(--brand2))!important;color:#fff!important;box-shadow:0 10px 25px rgba(109,93,252,.22)}button:hover,.btn:hover,.search-btn:hover,.btn-login:hover,.hero .btn:hover{transform:translateY(-2px);box-shadow:0 14px 30px rgba(109,93,252,.28)}.btn-danger{background:#fff1f2!important;color:#be123c!important;border:1px solid #fecdd3!important}.btn-secondary,.clear-btn{background:#eef0f5!important;color:#344054!important}.form-control,input[type=text],input[type=email],input[type=password],input[type=file],textarea,.search-input{border:1px solid #dfe3eb!important;background:#fff!important;border-radius:12px!important;padding:.8rem 1rem!important;box-shadow:none!important;transition:border-color .2s,box-shadow .2s!important}input:focus,textarea:focus,.form-control:focus,.search-input:focus{border-color:#8b7fff!important;box-shadow:0 0 0 4px rgba(109,93,252,.11)!important;outline:none}.alert{border-radius:14px!important;border:0!important;box-shadow:0 8px 25px rgba(20,24,39,.06)}
.hero{padding:7rem 0 6rem!important;text-align:center;background:linear-gradient(135deg,#171b2a 0%,#24213f 55%,#3d2d6d 100%);color:#fff;position:relative;overflow:hidden}.hero:before,.hero:after{content:'';position:absolute;border-radius:50%;filter:blur(10px);opacity:.28}.hero:before{width:360px;height:360px;background:#9f8cff;top:-190px;left:-80px}.hero:after{width:300px;height:300px;background:#d9b7ff;right:-80px;bottom:-180px}.hero .container{position:relative;z-index:1}.hero h2{font-family:'Playfair Display',serif;font-size:clamp(2.8rem,6vw,5.2rem);line-height:1.05;margin:0 0 1.2rem}.hero p{font-size:1.16rem;max-width:620px;margin:0 auto 2rem;color:#d8d9e5}.hero .btn{display:inline-block;padding:.9rem 1.35rem}.posts-section{padding:5rem 0!important}.posts-section h2,.container>h2,.container>h3{font-family:'Playfair Display',serif;color:var(--ink);letter-spacing:-.02em}.posts-section h2{font-size:2.4rem;margin-bottom:1.5rem}.posts{display:grid!important;grid-template-columns:repeat(3,minmax(0,1fr));gap:1.4rem!important}.post{background:rgba(255,255,255,.9)!important;border:1px solid var(--line);border-radius:var(--radius)!important;padding:0!important;overflow:hidden;box-shadow:0 8px 25px rgba(20,24,39,.045)!important;max-width:none!important;min-width:0!important;transition:transform .25s,box-shadow .25s,border-color .25s}.post:hover{transform:translateY(-7px);box-shadow:var(--shadow)!important;border-color:#d7d0ff}.post img{width:100%!important;height:210px!important;object-fit:cover;border-radius:0!important}.post h3,.post p,.post>a{margin-left:1.25rem;margin-right:1.25rem}.post h3{font-size:1.25rem;margin-top:1.2rem;margin-bottom:.55rem;line-height:1.35}.post p{color:var(--muted);font-size:.95rem}.post>a{display:inline-block;margin-top:auto;margin-bottom:1.25rem;font-weight:700}.search-container{background:#fff;border:1px solid var(--line);padding:.7rem;border-radius:16px;box-shadow:0 8px 25px rgba(20,24,39,.05);align-items:center}.search-input{max-width:none