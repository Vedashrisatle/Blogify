footer{background:#121624!important;color:#cbd0dc!important;padding:3.5rem 5%!important;margin-top:4rem}footer a{color:#e8eaff!important}footer h5{color:#fff!important;font-family:'Playfair Display',serif}footer .container{width:min(1120px,92%)}footer p{margin-bottom:.55rem}.text-primary{color:#a99eff!important}.text-dark{color:#cbd0dc!important}
.about-card,.card,.login-card,.profile-form,.comment-card,.blog-card{background:rgba(255,255,255,.96)!important;border:1px solid var(--line)!important;border-radius:22px!important;box-shadow:var(--shadow)!important}.about-card{padding:3.5rem!important;margin:5rem auto!important;text-align:left!important}.about-card h2{font-family:'Playfair Display',serif;font-size:3rem;margin-bottom:1.2rem}.about-card p{color:var(--muted);font-size:1.08rem}.container1{min-height:calc(100vh - 74px)!important;background:radial-gradient(circle at top right,#ece8ff,transparent 35%);padding:3rem 1rem!important;height:auto!important}.card{padding:2.5rem!important;max-width:760px!important}.card h2,.login-card h2{font-family:'Playfair Display',serif}.login-card{border-top:0!important;padding:2.7rem!important;width:min(440px,92vw)!important}.signin{text-align:center;margin-top:1.2rem;color:var(--muted)}body:has(.login-card),body:has(.card form){background:linear-gradient(135deg,#f6f4ff,#f8f9fc)}
.blog-card{padding:0!important;overflow:hidden;margin-bottom:1.4rem!important}.blog-card img{height:220px!important;border-radius:0!important}.blog-card h5,.blog-card p,.blog-card .d-flex{margin-left:1.1rem;margin-right:1.1rem}.blog-card h5{font-size:1.15rem;margin-top:1rem}.blog-card p{color:var(--muted)}.comment-card{padding:1.4rem!important}.blog-body{background:#fff!important;border:1px solid var(--line)!important;border-radius:18px!important;box-shadow:0 12px 35px rgba(20,24,39,.06)!important;text-align:left!important;padding:2.4rem!important;font-size:1.08rem!important;color:#374151!important}.blog-body::before{background:linear-gradient(90deg,var(--brand),#c084fc)!important}.img-fluid{box-shadow:var(--shadow);border-radius:18px!important}.comment{background:#fff!important;border:1px solid var(--line)!important;border-radius:14px!important;padding:1rem 1.2rem!important;box-shadow:0 6px 18px rgba(20,24,39,.04)}.profile-form{max-width:600px!important;padding:2.5rem!important;margin:4rem auto!important}.current-image{width:116px!important;height:116px!important;border:5px solid #eeeaff!important;box-shadow:0 10px 30px rgba(109,93,252,.18)}
@media(max-width:800px){header .container{align-items:flex-start;flex-direction:column;gap:1rem}nav ul,.menu,.navbar-nav{flex-wrap:wrap}.posts{grid-template-columns:repeat(2,minmax(0,1fr))}.search-container{flex-wrap:wrap}.search-input{min-width:100%;flex:1}.about-card{padding:2rem!important}.hero{padding:5rem 0 4rem!important}.blog-body{padding:1.4rem!important}.blog-card{margin-bottom:1rem!important}}
@media(max-width:560px){.container{width:92%}.posts{grid-template-columns:1fr}.hero h2{font-size:3rem}.post img{height:190px!important}.about-card h2{font-size:2.3rem}.search-container{gap:.5rem!important}.search-btn,.clear-btn{flex:1}.card,.login-card,.profile-form{padding:1.6rem!important}nav a,.nav-link{padding:.45rem .55rem!important;font-size:.88rem}.logo,.navbar-brand{font-size:1.4rem!important}}
</style>

</head>
<body>
  <header>
  <div class="container">
    <h1 class="logo">BLOGIFY</h1>
    <nav>
      <ul>
        <li><a href="/">Home</a></li>
        <li><a href="/posts">Posts</a></li>
        <li><a href="/about">About</a></li>

      </ul>
    </nav>
  </div>
</header>


  <div class="container mt-4">
    <h2>My Comments</h2>
    <% if (userComments && userComments.length > 0) { %>
      <% userComments.forEach(comment => { %>
        <div class="comment-card" id="comment-<%= comment._id %>">
          <p><strong>On blog:</strong> <a href="/blog/<%= comment.blog._id %>"><%= comment.blog.title %></a></p>
          <p><strong>Your comment:</strong> <%= comment.content %></p>
          <small class="text-muted">Posted on <%= comment.createdAt.toDateString() %></small>
          <div class="mt-2">
            <button class="btn btn-danger btn-sm delete-comment-btn" data-comment-id="<%= comment._id %>">
              <i class="fas fa-trash"></i> Delete Comment
            </button>
          </div>
        </div>
      <% }) %>
    <% } else { %>
      <div class="alert alert-info">
        <h4>No comments found</h4>
        <p>You haven't commented on any blogs yet. <a href="/">Browse blogs</a> to start commenting.</p>
      </div>
    <% } %>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script>
    document.addEventListener('DOMContentLoaded', function() {
      // Handle delete comment buttons
      document.querySelectorAll('.delete-comment-btn').forEach(button => {
        button.addEventListener('click', async function() {
          const commentId = this.getAttribute('data-comment-id');
          const commentCard = document.getElementById(`comment-${commentId}`);

          if (confirm('Are you sure you want to delete this comment?')) {
            try {
              const response = await fetch(`/user/delete-comment/${commentId}`, {
                method: 'DELETE',
                headers: {
                  'Content-Type': 'application/json',
                }
              });

              if (response.ok) {
                // Remove the comment from the page
                commentCard.remove();
                alert('Comment deleted successfully!');
              } else {
                alert('Failed to delete comment. Please try again.');
              }
            } catch (error) {
              console.error('Error deleting comment:', error);
              alert('An error occurred while deleting the comment.');
            }
          }
        });
      });
    });
  </script>
</body>
</html>
